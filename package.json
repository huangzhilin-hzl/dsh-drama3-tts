{
  "name": "dsh-drama3-tts",
  "version": "0.2.0",
  "private": true,
  "description": "Concise replies and technical pronunciation with local Drama 3 reference voices or Fish Audio",
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check lib/text.js && node --check lib/script-validation.js && node --check pronunciation.js && node --check prosody.js && node --check speech-check.js"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/",
    "pronunciation.js",
    "prosody.js",
    "speech-check.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "examples/reference-audio/",
    "examples/demo/",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
